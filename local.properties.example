# Copy this file to `local.properties` and fill in your values.
# `local.properties` is gitignored — never commit real secrets.
# Every key here can also be supplied as an environment variable.

# aisstream.io API key (required). Get one at https://aisstream.io/.
AIS_API_KEY=your_aisstream_api_key_here

# Initial bounding-box preset. Must match a key defined in `bounding-boxes.json`
# (default keys: bari | nord_adriatico | taranto | puglia).
BBOX_PRESET=bari

# Enrich ship details by scraping VesselFinder / MarineTraffic (true | false).
IMPORT_VF_DATA=false
IMPORT_MT_DATA=false

# Screen ships against the OFAC SDN sanctions list (downloaded, matched by
# IMO/name/call sign). A match is a very strong risk signal (true | false).
IMPORT_SANCTIONS=false

# Additional sanctions lists on top of OFAC: EU consolidated, UK OFSI and UN
# designated vessels (via OpenSanctions, downloaded daily). Only effective while
# IMPORT_SANCTIONS is on. Default on — set to false to screen against OFAC only.
IMPORT_SANCTIONS_EXTRA=true

# Equasis ownership lookup (true | false). On-demand only: enables the "Recupera
# informazioni Equasis" button in the ship detail to fetch registered owner / ISM
# manager / operator by IMO. Never runs automatically. Needs a free Equasis
# account (register at https://www.equasis.org/) set below.
IMPORT_EQUASIS=false
EQUASIS_USER=
EQUASIS_PASSWORD=

# Port State Control screening (true | false): Paris/Tokyo MoU flag-performance
# lists (white/grey/black, bundled, updated yearly) + Paris MoU banned-ships list
# (downloaded daily). Banned = refusal of access after repeated detentions.
IMPORT_PSC=false

# Global Fishing Watch enrichment (true | false). Default ON. Adds GFW vessel
# identity + behavioural events (encounters, loitering, port visits, AIS-off
# "gaps") to the ship detail and the risk score. Needs an API token (NOT the
# website login): generate one at https://globalfishingwatch.org/our-apis/ and
# paste it below. Free tier is non-commercial use only. Without a token the
# feature stays inert (the detail panel shows a hint).
IMPORT_GFW=true
GLOBAL_FISHING_WATCH_TOKEN=

# HTTP Basic Auth. Leave AUTH_PASSWORD empty to disable auth (recommended only
# for local use). Set a password to gate the whole app behind a browser login
# before exposing it on a network/internet. Basic auth sends credentials in
# base64 (≈ cleartext) — put TLS in front or use an SSH tunnel when public.
AUTH_USER=admin
AUTH_PASSWORD=
